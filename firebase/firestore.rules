rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TODO: tighten rules (e.g. match perfis/{id} where request.auth.uid == id).
    // For development, authenticated users can read/write all documents.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
